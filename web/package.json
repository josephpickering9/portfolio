{
  "name": "work-experience",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/postbuild.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "nuxt start",
    "postinstall": "nuxt prepare",
    "prepare": "cd .. && husky web/.husky",
    "codegen": "curl -sf ${OPENAPI_URL:-http://localhost:5105/swagger/v1/swagger.json} -o .openapi.json && openapi-ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint $(git diff --name-only --cached --relative | grep -E '\\.(js|vue|ts)$' | xargs)",
    "lint:full": "eslint .",
    "lint:commit": "eslint",
    "typecheck": "vue-tsc --noEmit",
    "generate-meta": "node scripts/generate-meta-image.js --include 'alnwick-castle,yorkshire-sculpture-park,storybook,beatcovidne,taxigoat,boiler-plan,visit-northumberland,glasgow-retina,research-portal,nightingale-design-research'",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{js,vue,ts}": "yarn lint:commit"
  },
  "resolutions": {
    "rollup": "^4.59.0",
    "h3": "^1.15.5",
    "tar": "^7.5.11",
    "node-forge": "^1.3.2",
    "ejs": "^3.1.10",
    "serialize-javascript": "^7.0.3",
    "braces": "^3.0.3",
    "svgo": "^4.0.1",
    "minimatch": "^10.2.3",
    "lodash-es": "^4.17.23",
    "markdown-it": "^14.1.1",
    "js-yaml": "^4.1.1",
    "diff": "^4.0.4"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.28.4",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tiptap/core": "^3.20.2",
    "@tiptap/extensions": "^3.20.2",
    "@tiptap/pm": "^3.20.2",
    "@tiptap/starter-kit": "^3.20.2",
    "@tiptap/vue-3": "^3.20.2",
    "@vue/devtools-api": "^8.2.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "h3": "^1.15.5",
    "lodash-es": "^4.17.23",
    "markdown-it": "^14.1.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.2.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hey-api/openapi-ts": "^0.97.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt": "^4.4.2",
    "nuxt-security": "^2.6.0",
    "nuxt-umami": "^3.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5",
    "zod": "^4.6.5"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
